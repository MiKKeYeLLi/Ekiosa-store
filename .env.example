# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase (Project Settings → API) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key, or the newer "publishable" key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role key, or the newer "secret" key (sb_secret_...). SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this site — used for OAuth redirects and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mailgun (Sending → Domains, and API Security) ────────────────
MAILGUN_API_KEY=
# e.g. sandboxXXXX.mailgun.org for testing, or mg.yourdomain.com
MAILGUN_DOMAIN=
MAILGUN_FROM="Loam <orders@your-mailgun-domain>"
# https://api.mailgun.net (US) or https://api.eu.mailgun.net (EU)
MAILGUN_API_BASE=https://api.mailgun.net

# ── Database (only for `npm run db:apply`; never used by the app) ──
# Project Settings → Database → Connection string → URI (session pooler works on IPv4 networks)
SUPABASE_DB_URL=
