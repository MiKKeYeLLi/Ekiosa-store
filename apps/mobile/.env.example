# Copy to apps/mobile/.env (git-ignored). These values are PUBLIC — they ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The deployed web app (hosts POST /api/orders). For a local test, use your PC's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://ekiosa-store.vercel.app
# Google Cloud → Credentials → the *Web application* OAuth client ID (the same one configured in Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
